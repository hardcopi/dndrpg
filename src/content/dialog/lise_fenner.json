        "as_asked": [
            {
                "conditions": [
                    {
                        "flag": "fenmoor_asked_for"
                    }
                ],
                "text": "\"Coll told you Wat said 'it's been asked for',\" Lise Fenner says, before you can. \"Coll would. He's been telling people that for two winters, so it'd sound like something.\" She looks at the line she cannot read. \"Wat said it about everything. A cheese had been asked for. I'd been asked for, once, by his mother.\" A pause. \"I don't know. I never asked him what he carried. You don't, if you want him to keep coming home.\"",
                "interjections": [
                    {
                        "companion": "sera",
                        "text": "Sera: \"It's the same sentence either way. That's what's clever about it. Nobody had to be clever.\""
                    }
                ],
                "choices": [
                    {
