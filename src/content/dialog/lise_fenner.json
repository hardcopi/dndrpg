        "kept": [
            {
                "text": "\"Take it,\" Lise Fenner says. \"A book's only worth keeping if somebody reads it.\" She wraps it back in its oilcloth with more care than she has used on anything else and puts it in your hands. \"If you find out who asked, don't come and tell me. I'd rather think he was tired.\"",
                "choices": [
                    {
                        "label": "Leave.",
                        "end": true
                    }
                ]
            }
        ],
        "left": [
            {
                "text": "She takes the book back, and holds it a moment, and goes below with it. When she comes up again her hands are empty and she picks up the pot. \"That's the end of it, then,\" she says. \"It usually is, with Wat. He went up the road and he came back down it and you never knew what was on the cart.\"",
                "choices": [
                    {
                        "label": "Leave.",
                        "end": true
                    }
                ]
            }
        ],
        "paid": [
            {
                "text": "\"That's for the burying,\" she says, looking at the coins. \"That's not for the book.\" You say you know. She counts it twice, the way people count money they did not expect, and puts it in her apron. \"Jory'll cross it out,\" she says. \"He's been good. Six gold in two winters, a shilling a week, and he never once asked me for it.\" She does not thank you, and you understand that she cannot quite, yet.",
                "interjections": [
                    {
                        "companion": "kessa",
                        "text": "Kessa, low: \"That's the only thing on this whole trail anybody could pay off.\""
                    }
                ],
                "choices": [
                    {
                        "label": "Leave.",
                        "end": true
                    }
                ]
            }
