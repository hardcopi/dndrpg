                ]
            },
            {
                "conditions": [
                    {
                        "flag": "meeting_fate",
                        "equals": "walked"
                    }
                ],
                "once": true,
                "text": "\"Walked out on them.\" The miner nods slowly. \"Only time I walked off a shift I was docked the day. Hope they docked you.\"",
                "choices": [
