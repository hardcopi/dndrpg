                ]
            },
            {
                "conditions": [
                    {
                        "flag": "meeting_fate",
                        "equals": "walked"
                    }
                ],
                "once": true,
                "text": "\"Walked out on them, I heard.\" He shakes his head. \"Keep to the street. The lamps are there for a reason.\"",
                "choices": [
