{
    "npc_key": "market_farmer",
    "start": "hail",
    "nodes": {
        "hail": [
            {
                "conditions": [
                    {
                        "flag": "meeting_fate",
                        "equals": "costed"
                    }
                ],
                "once": true,
                "text": "\"A year's bread,\" the farmer says. \"That's what they've costed us at, I hear. A year's bread, and the bread's off my field, sold forward two harvests back.\" A short laugh. \"So they'll be paying themselves for it.\"",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ]
            },
            {
                "conditions": [
                    {
                        "flag": "meeting_fate",
                        "equals": "minuted"
                    }
                ],
                "once": true,
                "text": "\"Wrote it down, did they.\" The farmer shrugs. \"So did the man who bought my harvest forward. Lovely hand, he had.\"",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ]
            },
            {
                "conditions": [
                    {
                        "flag": "meeting_fate",
                        "equals": "subscribed"
                    }
                ],
                "once": true,
                "text": "\"One of the owners, word is.\" The farmer looks you up and down. \"Then my grain's been partly yours two years. You'll not mind me saying the price was poor.\"",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ]
            },
            {
                "conditions": [
                    {
                        "flag": "meeting_fate",
                        "equals": "walked"
                    }
                ],
                "once": true,
                "text": "\"Walked out on them.\" The farmer grins in spite of himself. \"Can't walk out on a forward contract. I've looked.\"",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ]
            },
            {
                "conditions": [
                    {
                        "flag": "harrow_fate",
                        "equals": "sold"
                    }
                ],
                "once": true,
                "text": "\"Harrow's place went, then,\" the farmer says, weighing nothing in particular. \"Good price, they say. Hired cart, downriver, never looked back.\" He looks east instead, at his own ditches. \"Letter came to me Tuesday. My first. Very civil. No name on it.\"",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ]
            },
            {
                "conditions": [
                    {
                        "flag": "harrow_fate",
                        "equals": "brokered"
                    }
                ],
                "once": true,
                "text": "\"You're the one took the fee for Harrow's,\" the farmer says, not loudly. \"Word gets round a market.\" He turns his back to sort sacks that do not need sorting, and he is still sorting them when you go.",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ]
            },
            {
                "text": "Grain's weighed at the granary, not here. Reeve's rules, not mine.",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ]
            }
        ]
    }
}
