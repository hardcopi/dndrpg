        ],
        "the_name": [
            {
                "text": "\"The house takes a fortieth off everything that goes through the yard,\" Jory says. \"So I named it the Fortieth, as a joke. Twenty years ago.\" He looks at the letters over the door, painted over something else. \"It was funnier then. Not because anything changed. Just because it's been twenty years.\"",
                "choices": [
                    {
                        "label": "Back.",
                        "next": "greeting"
                    }
                ]
            }
        ],
        "the_house": [
            {
                "text": "\"Nothing much. Pays its bills on the day. Never shouts. Bought the wharf in my father's time and the rent's gone up about as you'd expect.\" He wipes the bar. \"People who come down from up a valley always want it to be something. It's a lot of clerks. The clerks drink at that end. Ask them. They're lovely.\"",
                "interjections": [
                    {
                        "companion": "kessa",
                        "text": "Kessa looks down the bar at the clerks' end for a long moment and decides against it."
                    }
                ],
                "choices": [
                    {
                        "label": "Back.",
                        "next": "greeting"
                    }
                ]
            }
        ]
