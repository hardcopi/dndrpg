        "beside": [
            {
                "text": "She opens the field books at the Rivermark margin and you lay sheet six beside them. They agree. The chain is Pyke's hand and two others; the figure in the margin is the figure on your sheet, revised downward twice, in the same order. Your survey is a fair copy of something nobody had lost. Dorcas Fenn watches you understand it with real sympathy. \"Everybody brings the copy,\" she says. \"I'd file it, if I were you. Then it's a record that somebody outside held it. Or keep it. It's yours either way.\"",
                "interjections": [
                    {
                        "companion": "aldric",
                        "text": "Aldric: \"File it. Let it be a record.\""
                    },
                    {
                        "companion": "sera",
                        "text": "Sera: \"Keep it. A record in their building is a record in their building.\""
                    }
                ],
                "choices": [
                    {
                        "label": "Keep it. Thank you for showing me.",
                        "effects": [
                            {
                                "quest_stage": {
                                    "quest": "a_record_is_not_the_thing",
                                    "stage": "compared"
                                }
                            }
                        ],
                        "next": "kept"
                    },
                    {
                        "label": "File it, under my name. (9 gold)",
                        "conditions": [
                            {
                                "gold_at_least": 9
                            }
                        ],
                        "effects": [
                            {
                                "quest_stage": {
                                    "quest": "a_record_is_not_the_thing",
                                    "stage": "filed"
                                }
                            }
                        ],
                        "next": "filed"
                    }
                ]
            }
        ],
        "kept": [
            {
                "text": "Dorcas Fenn nods, and shelves the forty-one books one by one, exactly where they were. \"A copy's still worth something,\" she says. \"It's the thing somebody has to ask you for.\"",
                "choices": [
                    {
                        "label": "Leave.",
                        "end": true
                    }
                ]
            }
        ],
        "filed": [
            {
                "text": "She takes the nine sheets and writes them into the day book in a round hand: Survey, Rivermark, nine sheets, fair copy, deposited by the bearer. A penny a page. \"Anybody can read it now,\" she says, \"for a penny. Most won't. Some will. That's all a record ever does.\"",
                "choices": [
                    {
                        "label": "Leave.",
                        "end": true
                    }
                ]
            }
        ],
        "read_anything": [
            {
                "text": "\"Anything filed,\" she says. \"Deeds, conveyances, writs, field books, assignments, the bound minutes of the meeting back to the beginning. Nobody reads the minutes. They're very dull. That isn't an accident, but it isn't a plot either. Most important things are dull, and most dull things are important to somebody.\"",
                "choices": [
                    {
                        "label": "I'm after a Greyhythe sale. An armourer's stock. The Fenmoor lot.",
                        "conditions": [
