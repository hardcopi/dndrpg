                                    "stage": "brindle_and_daughter"
                                }
                            }
                        ],
                        "end": true
                    },
                    {
                        "label": "Leave.",
                        "end": true
                    }
                ]
            }
        ],
        "the_minute": [
            {
                "text": "Item seven. Rivermark.\n\nA party from the valley, attending on business, objected to the entry for Rivermark on sheet six of the survey under the head clearance, and asked that its objection be entered word for word. The objection follows.\n\nAnd then your own words, exactly, in Minna Crale's hand, every one of them, including the two you would take back.\n\nThe meeting noted the objection. No resolution was moved.\n\nItem eight. Any other business. None.\n\n\"Two pages,\" Dorcas Fenn says from the ladder. \"Tuppence. It's the most anybody from up the valley has ever had in a bound volume. Mostly the valley is a figure.\"",
                "interjections": [
                    {
                        "companion": "aldric",
                        "text": "Aldric: \"It is there.\" He reads it again. \"It is all there. I said it was not nothing.\""
                    }
                ],
                "choices": [
                    {
                        "label": "Copy it out. It's going up the valley.",
                        "effects": [
                            {
                                "take_gold": 1
                            },
                            {
                                "quest_stage": {
                                    "quest": "the_bound_minute",
                                    "stage": "copied"
                                }
                            }
                        ],
                        "next": "minute_copied"
                    },
                    {
                        "label": "Leave it on the shelf, where anyone can read it.",
                        "effects": [
                            {
                                "quest_stage": {
                                    "quest": "the_bound_minute",
                                    "stage": "shelved"
                                }
                            }
                        ],
                        "next": "minute_shelved"
                    },
                    {
                        "label": "Not now.",
                        "end": true
                    }
                ]
            }
        ],
        "minute_copied": [
            {
                "text": "You copy it out at the reading desk, both pages, and Dorcas Fenn takes the pennies without comment and gives you a sheet of good paper for nothing, which you suspect she has never done before. \"Pin it somewhere it can be read,\" she says. \"That's the whole of the job.\"",
                "choices": [
                    {
                        "label": "Leave.",
                        "end": true
                    }
                ]
            }
        ],
        "minute_shelved": [
            {
                "text": "Dorcas Fenn takes the volume back up the ladder and puts it where it goes, between the dividend and the drains. \"Anybody may read it,\" she says. \"That's what it's for.\"",
                "choices": [
                    {
                        "label": "Leave.",
                        "end": true
                    }
                ]
            }
        ]
    }
