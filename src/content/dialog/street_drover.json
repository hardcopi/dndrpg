{
    "npc_key": "street_drover",
    "start": "hail",
    "nodes": {
        "hail": [
            {
                "conditions": [
                    {
                        "flag": "meeting_fate",
                        "equals": "costed"
                    }
                ],
                "once": true,
                "text": "\"Carts, they're saying. Somebody downriver's counting the carts it'd take to shift us.\" The drover pats an ox. \"Tell them I want paying by the mile. These two don't come cheap and they don't come quick.\"",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ]
            },
            {
                "conditions": [
                    {
                        "flag": "meeting_fate",
                        "equals": "minuted"
                    }
                ],
                "once": true,
                "text": "\"Wrote it down, did they.\" The drover chews a straw. \"My oxen don't read. Works out well for everybody.\"",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ]
            },
            {
                "conditions": [
                    {
                        "flag": "meeting_fate",
                        "equals": "subscribed"
                    }
                ],
                "once": true,
                "text": "\"Bought a share, I heard. In the buying.\" The drover considers the ox. \"He's not for sale. I'd like that minuted, or whatever it is you lot do.\"",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ]
            },
            {
                "conditions": [
                    {
                        "flag": "meeting_fate",
                        "equals": "walked"
                    }
                ],
                "once": true,
                "text": "\"Walked out.\" The drover grins. \"Oxen do that. Middle of a furrow, done. You have to respect it.\"",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ]
            },
            {
                "conditions": [
                    {
                        "flag": "mill_is_shelter"
                    }
                ],
                "text": "\"Dry wall two miles up the road,\" the drover says, as if passing on a secret. \"The old mill. Hurdles and a slate over the fire-back.\" The ox shifts. \"Slept there Thursday with four others and the rain on the hurdles. Nobody knows whose it is now. Nobody asked me for a penny.\"",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ],
                "once": true
            },
            {
                "conditions": [
                    {
                        "flag": "commons_question_raised"
                    }
                ],
                "text": "\"They're still at it on the weighing floor,\" the drover says. \"Three holders and a clerk, every market day, asking who bought the common and when.\" He chews the straw. \"Nobody's answered. But it's on the floor now, where the weights are, and you can't unsay a thing on a weighing floor.\"",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ],
                "once": true
            },
            {
                "text": "Wagons won't run the east road till it's safe. My oxen agree with the wagons.",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ]
            }
        ]
    }
}
