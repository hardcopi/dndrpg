            {
                "conditions": [
                    {
                        "flag": "meeting_fate",
                        "equals": "costed"
                    }
                ],
                "once": true,
                "text": "\"Heard the one about the town that got costed? Carts, roofs, a year's bread.\" A bow. \"No punchline. They're still adding it up.\"",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ]
            },
            {
                "conditions": [
                    {
                        "flag": "meeting_fate",
                        "equals": "minuted"
                    }
                ],
                "once": true,
                "text": "\"They wrote down every word you said! There's a joke nobody laughs at for a hundred years.\"",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ]
            },
            {
                "conditions": [
                    {
                        "flag": "meeting_fate",
                        "equals": "subscribed"
                    }
                ],
                "once": true,
                "text": "\"Bought a chair at their table! What's the difference between an owner and a jester? The jester knows who he works for.\"",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ]
            },
            {
                "conditions": [
                    {
                        "flag": "meeting_fate",
                        "equals": "walked"
                    }
                ],
                "once": true,
                "text": "\"Walked out in the middle! Best exit I've heard all year, and I've been booed off by a goat.\"",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ]
            },
            {
                "text": "A copper for a joke? No? The joke's free then: everything here costs copper.",
                "choices": [
                    {
                        "label": "Leave them to it.",
                        "end": true
                    }
                ]
            }
        ]
    }
