                    },
                    {
                        "not": {
                            "flag": "packet_gone"
                        }
                    }
                ],
                "once": true,
                "text": "\"Walked out on them,\" Tull says, and laughs once, like a door going. \"Moss nearly dropped his pen.\"",
                "choices": [
                    {
                        "label": "Leave.",
                        "end": true
                    }
                ]
