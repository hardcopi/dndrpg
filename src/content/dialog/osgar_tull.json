        "packet_b": [
            {
                "text": "\"Four days,\" Tull says, coiling the last of the rope onto the deck. \"Then it comes back up with whatever they said, and I'll carry that too. It'll weigh the same.\" He steps aboard and casts off. The packet slides out past the green steps into the current and goes round the second bend, and then there is only the river and the empty seventh step. Whatever they say down there, they have not said it yet.",
                "choices": [
                    {
                        "label": "Watch it out of sight.",
                        "effects": [
                            {
                                "set_flag": "packet_gone"
                            }
                        ],
                        "end": true
                    }
                ],
                "interjections": [
                    {
                        "companion": "sera",
                        "text": "Sera, hands in her sleeves: \"Four days for paper to go somewhere I can't follow it. I've never once enjoyed it.\"",
                        "once": true
                    },
                    {
                        "companion": "aldric",
                        "text": "Aldric watches the bend long after the packet has gone round it.",
                        "once": true
                    },
                    {
                        "companion": "kessa",
                        "text": "Kessa skims a stone after it. It goes four bounces and sinks. \"Good enough,\" she says.",
                        "once": true
                    },
                    {
                        "companion": "ilse",
                        "text": "Ilse: \"Five days, then.\" She does not say until what.",
                        "once": true
                    }
                ]
            }
        ],
        "the_gangplank": [
            {
                "text": "The gangplank is a single board with cleats nailed across it, wet at the bottom and dry at the top. You stand at the foot of it with your vote in your coat. It weighs nothing; Tull has said so about every paper he has ever carried. He does not hurry you. Nobody on the stair says anything. Somewhere up the town a door opens and shuts. The bell has not gone yet.",
                "choices": [
                    {
                        "label": "Step aboard.",
                        "effects": [
                            {
                                "set_flag": "vote_aboard"
                            },
                            {
                                "set_flag": "packet_gone"
                            }
                        ],
                        "next": "aboard"
                    },
                    {
                        "label": "Step back onto the stair.",
                        "effects": [
                            {
                                "set_flag": "packet_gone"
                            }
                        ],
                        "next": "stayed_on_the_stair"
                    }
                ],
                "interjections": [
                    {
                        "companion": "sera",
                        "once": true,
                        "text": "Sera, at your shoulder: \"I'm not going to tell you which. I'd only be telling you what I'd do.\""
                    },
                    {
                        "companion": "aldric",
                        "once": true,
                        "text": "Aldric says nothing at all, and takes his hat off, and holds it."
                    },
                    {
                        "companion": "kessa",
                        "once": true,
                        "text": "Kessa, cheerfully: \"Either way, somebody in that room is going to be annoyed.\""
                    },
                    {
                        "companion": "ilse",
                        "once": true,
                        "text": "Ilse looks at the plank, and then at you, and waits, which she is better at than anybody."
                    }
                ]
            }
        ],
        "aboard": [
            {
                "text": "You go up the plank, and Tull pulls it in after you and casts off, and the packet slides out past the green steps and round the second bend. Four days down. A morning in a warm room, with a chair kept for you and a vote in your coat. What you do with it there, you have not done yet.",
                "choices": [
                    {
                        "label": "Go below.",
                        "effects": [
                            {
                                "travel": {
                                    "location": "brackwater_wharf"
                                }
                            }
                        ],
                        "end": true
                    }
                ]
            }
        ],
        "stayed_on_the_stair": [
            {
                "text": "You step back onto the seventh step. Tull looks at you for exactly as long as he looks at anybody, nods, pulls the plank in and casts off. The packet goes round the second bend without you. Your vote is still in your coat, uncast. The room will sit without it, and it will still be yours.",
                "choices": [
                    {
                        "label": "Watch it out of sight.",
                        "end": true
                    }
                ]
            }
        ],
        "the_room_sat": [
            {
                "text": "It is in Minna Crale's hand, which you know now, and it is very short.\n\n*The house sat on the quarter-day at ten o'clock. Members present, and proxies, as entered. The business of the day was taken in its order. The minute will follow.*\n\nThat is all of it. Somebody reads it out again from the top of the steps, louder, as if that might make it longer. It does not. The room sat. What it did, sitting, is in a minute that is still in Brackwater.",
                "choices": [
                    {
                        "label": "Go up into the town.",
                        "effects": [
                            {
                                "set_flag": "room_sat"
                            }
                        ],
                        "end": true
                    }
                ],
                "interjections": [
                    {
                        "companion": "sera",
                        "once": true,
                        "text": "Sera reads it twice. \"'Taken in its order,'\" she says. \"That's the most they've ever told anybody and it's nothing at all.\""
                    },
                    {
                        "companion": "aldric",
                        "once": true,
                        "text": "Aldric: \"'The minute will follow.' They always say it. In my experience it usually does, eventually, and it is never the shape anyone hoped.\""
                    },
                    {
                        "companion": "kessa",
                        "once": true,
                        "text": "Kessa, delighted: \"They've sent us a letter that says they've had a meeting.\""
                    },
                    {
                        "companion": "ilse",
                        "once": true,
                        "text": "Ilse folds her arms. \"Then we wait for the next boat.\" She does not sound like she minds."
                    }
                ]
            }
        ]
    }
}
