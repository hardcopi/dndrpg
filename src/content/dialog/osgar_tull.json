                        "not": {
                            "flag": "packet_gone"
                        }
                    }
                ],
                "once": true,
                "text": "Tull looks at you for a long moment. \"Nineteen years carrying for the house,\" he says, \"and I've never had an owner aboard.\" He goes back to the rope. \"You'll sit where everybody sits.\"",
                "choices": [
                    {
                        "label": "Leave.",
                        "end": true
