# Local-only database credentials. CLAUDE.md: this file is excluded from both
# pull.sh and deploy.sh so production credentials never land on this machine and
# dev credentials never reach production. It must not be committed either.
src/app/config/database.php

# Database dumps taken before a rebuild. Snapshots of somebody's save, not code.
backups/
*.sql.gz
backup.sql

__pycache__/
*.pyc
.DS_Store

# The tile renderer's art: four directories (~36MB), most of it dead weight,
# and the slice of it the battle map draws, which is not.
#
# The world became a location graph on 2026-08-01 and the DOM tile renderer
# went with it. What it left behind in tiles/, decor/, buildings/ and anim/ is
# ignored rather than deleted: it is somebody's art, keeping it on disk costs a
# directory listing, and putting all of it in every clone would cost 36MB.
# buildings/ and anim/ are named by nothing the game runs (`anim` only by
# tools/slice_assets.py, which is the tool that CUT them — the producer, not a
# consumer), so they stay ignored whole.
#
# The combat grid then came back to the leftovers. app/lib/BattleMapGen.php
# names a floor and a wall per palette (FLOORS, WALLS) and every prop in its
# PROPS table by path, and assets/js/ui-battlemap.js names tiles/water.png for
# shallow water. Those 51 files (~2.6 MiB) are what a fight draws, so they are
# versioned, byte-identical to the live site's copies: without them a fresh clone
# draws untextured boards and tools/test_combat.php fails on the missing paths.
# PNG only — the client loads the paths the server ships, and those all end
# .png; the tiles/*.svg beside them are the old renderer's and stay ignored.
#
# The list below is the literal paths in those two files, nothing derived
# (tools/combat_field_preview.html names only files already on it). A
# prop added to BattleMapGen needs its file un-ignored here too, or
# test_combat.php's "props sit on the cover they depict" check will name it.
# Directory contents (`dir/*`), not the directory, so the `!` lines can
# re-include: git cannot re-include a file whose parent directory is excluded.
src/assets/images/buildings/
src/assets/images/anim/
src/assets/images/tiles/*
!src/assets/images/tiles/floor_dungeon.png
!src/assets/images/tiles/floor_stone.png
!src/assets/images/tiles/floor_wood.png
!src/assets/images/tiles/grass.png
!src/assets/images/tiles/road.png
!src/assets/images/tiles/wall_dungeon.png
!src/assets/images/tiles/wall_inn.png
!src/assets/images/tiles/wall_stone.png
!src/assets/images/tiles/water.png
src/assets/images/decor/*
!src/assets/images/decor/altar.png
!src/assets/images/decor/barrel_pile.png
!src/assets/images/decor/barrel.png
!src/assets/images/decor/barrel_rack.png
